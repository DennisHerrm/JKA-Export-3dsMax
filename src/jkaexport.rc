// ============================================================
//  jkaexport.rc - das Exportfenster. Masse in Dialogeinheiten,
//  Abstaende nach Microsofts Layoutregeln (Rand 7). Nur ASCII.
// ============================================================
#include <windows.h>
#include "jkaexport_res.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_EXPORT DIALOGEX 0, 0, 380, 262
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "JKA Export"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Character", -1, 7, 10, 50, 8
    COMBOBOX        IDC_FIGUR, 62, 8, 248, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Refresh", IDC_AKTUALISIEREN, 316, 7, 57, 15, BS_OWNERDRAW | WS_TABSTOP

    LTEXT           "Model name", -1, 7, 31, 50, 8
    EDITTEXT        IDC_NAME, 62, 29, 120, 12, ES_AUTOHSCROLL | ES_LOWERCASE | WS_TABSTOP | NOT WS_BORDER
    LTEXT           "Base folder", -1, 7, 50, 50, 8
    EDITTEXT        IDC_BASIS, 62, 48, 248, 12, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER
    PUSHBUTTON      "Browse...", IDC_DURCHSUCHEN, 316, 47, 57, 15, BS_OWNERDRAW | WS_TABSTOP
    LTEXT           "", IDC_ZIEL, 62, 64, 311, 8, SS_PATHELLIPSIS | SS_NOPREFIX

    LTEXT           "Scale", -1, 7, 83, 50, 8
    EDITTEXT        IDC_SKALA, 62, 81, 40, 12, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER
    PUSHBUTTON      "Faces +Y: turn 180", IDC_DREHEN, 110, 80, 90, 15, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Feet at -24 (NPC)", IDC_BODEN, 204, 80, 82, 15, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "In place", IDC_ANORT, 290, 80, 83, 15, BS_OWNERDRAW | WS_TABSTOP

    PUSHBUTTON      "Write NPC file", IDC_NPC, 7, 104, 80, 15, BS_OWNERDRAW | WS_TABSTOP
    LTEXT           "Class", -1, 95, 107, 22, 8
    COMBOBOX        IDC_KLASSE, 120, 105, 140, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Health", -1, 268, 107, 26, 8
    EDITTEXT        IDC_GESUNDHEIT, 296, 105, 40, 12, ES_NUMBER | WS_TABSTOP | NOT WS_BORDER
    LTEXT           "", IDC_KLASSE_INFO, 120, 122, 253, 8, SS_NOPREFIX | SS_ENDELLIPSIS

    LTEXT           "", IDC_STATUS, 7, 140, 366, 92, SS_NOPREFIX

    PUSHBUTTON      "Export", IDOK, 253, 239, 58, 16, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Close", IDCANCEL, 315, 239, 58, 16, BS_OWNERDRAW | WS_TABSTOP
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DH"
            VALUE "FileDescription", "JKA Export - Ghoul2 GLM/GLA exporter for 3ds Max"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "JkaExport"
            VALUE "OriginalFilename", "JkaExport.dle"
            VALUE "ProductName", "JKA Export"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
